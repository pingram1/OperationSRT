# Copy to server/.env for the API and client/.env for Vite (prefix client vars with VITE_).
# When NODE_ENV=production, the server requires every variable listed under "Production required".

# --- Server core ---
NODE_ENV=development
PORT=3001
MONGO_URI=mongodb://localhost:27017/your-db
# Minimum 32 characters in production
JWT_SECRET=
# Independent secret for refresh tokens. If unset, falls back to JWT_SECRET+"_refresh"
# (legacy behavior). Set this to a separate >=32-char random string in production
# so a JWT_SECRET leak does not also enable refresh-token forgery.
JWT_REFRESH_SECRET=
# Reverse-proxy hop count for `app.set('trust proxy', n)`. 1 covers a single
# load balancer or CDN; raise to match your deployment topology.
TRUST_PROXY_HOPS=1

# Browser origins allowed by CORS in production (comma-separated, no trailing slashes)
# Local dev: http://localhost:5173 · Docker Compose stack in this repo: http://localhost:8080
FRONTEND_URL=http://localhost:5173

# --- Production required (server) ---
# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email (matches server/utils/emailService.js)
EMAIL_HOST=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_PORT=587
EMAIL_FROM=

# Error tracking (server SDK)
SENTRY_DSN=
# Optional: 0–1, default 0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Optional server ---
WHEREBY_API=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
ORGANIZATION_DOMAIN=
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=
LOG_LEVEL=info
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Client (client/.env) — Vite ---
# Use the same project DSN as the server, or a separate browser DSN from Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
